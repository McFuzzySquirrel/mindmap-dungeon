{
  "name": "mindmap-dungeon-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first desktop study game shell built with Tauri, React, Vite, and TypeScript.",
  "engines": {
    "node": ">=20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
